<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>EvalAI Hub — Coming Soon | EvalLoop AI</title>

  <meta
    name="description"
    content="EvalAI Hub is coming soon — explore the AI evaluation ecosystem, benchmarks, datasets, methods, research, and tools."
  />

  <meta name="theme-color" content="#101211" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --bg: #101211;
      --panel: #171b18;
      --panel2: #1d221f;
      --ink: #f1f1ef;
      --muted: #a4aaa6;
      --dim: #727974;
      --line: rgba(241, 241, 239, 0.14);
      --line-soft: rgba(241, 241, 239, 0.08);
      --green: #3ecf8e;
      --green2: #85e7ba;
      --darkgreen: #13261c;

      --sans:
        "Inter",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      --mono: "DM Mono", monospace;
      --max: 1200px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;

      color: var(--ink);
      background:
        radial-gradient(
          circle at 50% -15%,
          rgba(62, 207, 142, 0.1),
          transparent 34%
        ),
        linear-gradient(
          rgba(241, 241, 239, 0.022) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(241, 241, 239, 0.022) 1px,
          transparent 1px
        ),
        var(--bg);

      background-size:
        auto,
        48px 48px,
        48px 48px,
        auto;

      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -1;

      background:
        radial-gradient(
          circle at 15% 35%,
          rgba(62, 207, 142, 0.025),
          transparent 25%
        ),
        radial-gradient(
          circle at 85% 65%,
          rgba(62, 207, 142, 0.025),
          transparent 25%
        );
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(var(--max), calc(100% - 48px));
      margin: 0 auto;
    }

    /* =========================================================
       HEADER
    ========================================================= */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;

      background: rgba(16, 18, 17, 0.84);

      border-bottom: 1px solid var(--line-soft);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .header-inner {
      width: min(var(--max), calc(100% - 48px));
      min-height: 72px;
      margin: 0 auto;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 28px;
    }

    .brand {
      display: inline-flex;
      align-items: center;

      color: var(--ink);

      font-family: var(--mono);
      font-size: 15px;
      font-weight: 500;
      letter-spacing: -0.03em;
      white-space: nowrap;
    }

    .brand::after {
      content: "";

      width: 7px;
      height: 16px;

      margin-left: 2px;

      background: var(--green);

      animation: blink 1.05s steps(1) infinite;
    }

    @keyframes blink {
      0%,
      48% {
        opacity: 1;
      }

      49%,
      100% {
        opacity: 0;
      }
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;

      gap: 5px;
      min-width: 0;
    }

    .desktop-nav > a,
    .nav-dropdown > button {
      border: 0;
      background: transparent;

      color: var(--muted);

      padding: 9px 11px;
      border-radius: 4px;

      font-family: var(--sans);
      font-size: 13px;
      font-weight: 400;

      cursor: pointer;

      transition:
        color 160ms ease,
        background 160ms ease;
    }

    .desktop-nav > a:hover,
    .nav-dropdown > button:hover,
    .desktop-nav > a.active,
    .nav-dropdown > button.active {
      color: var(--ink);
      background: rgba(241, 241, 239, 0.045);
    }

    .nav-dropdown {
      position: relative;
    }

    .nav-dropdown > button {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .nav-chevron {
      width: 6px;
      height: 6px;

      border-right: 1px solid currentColor;
      border-bottom: 1px solid currentColor;

      transform: rotate(45deg) translateY(-2px);

      transition: transform 160ms ease;
    }

    .nav-dropdown.open .nav-chevron {
      transform: rotate(225deg) translateY(-1px);
    }

    .dropdown-menu {
      position: absolute;

      top: calc(100% + 9px);
      left: 50%;

      width: 285px;

      padding: 7px;

      background: rgba(23, 27, 24, 0.98);

      border: 1px solid var(--line);
      border-radius: 5px;

      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);

      opacity: 0;
      visibility: hidden;
      pointer-events: none;

      transform: translateX(-50%) translateY(-5px);

      transition:
        opacity 150ms ease,
        transform 150ms ease,
        visibility 150ms ease;
    }

    .nav-dropdown.open .dropdown-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;

      transform: translateX(-50%) translateY(0);
    }

    .dropdown-item {
      display: block;

      padding: 11px 12px;

      border-radius: 4px;

      transition: background 150ms ease;
    }

    .dropdown-item:hover,
    .dropdown-item.active {
      background: rgba(62, 207, 142, 0.07);
    }

    .dropdown-title {
      display: block;

      color: var(--ink);

      font-size: 13px;
      font-weight: 400;
      line-height: 1.35;
    }

    .dropdown-description {
      display: block;

      margin-top: 3px;

      color: var(--dim);

      font-family: var(--mono);
      font-size: 10px;
      line-height: 1.45;
    }

    .nav-actions {
      display: flex;
      align-items: center;

      gap: 3px;
      margin-left: 4px;
    }

    .nav-login {
      color: var(--muted) !important;
    }

    .nav-signup {
      color: var(--bg) !important;
      background: var(--green) !important;

      padding-inline: 14px !important;
    }

    .nav-signup:hover {
      background: var(--green2) !important;
    }

    /* =========================================================
       MOBILE NAV
    ========================================================= */

    .mobile-toggle {
      display: none;

      width: 42px;
      height: 42px;

      border: 1px solid var(--line);
      border-radius: 4px;

      background: transparent;
      color: var(--ink);

      cursor: pointer;
    }

    .mobile-toggle span,
    .mobile-toggle span::before,
    .mobile-toggle span::after {
      display: block;

      width: 17px;
      height: 1px;

      background: currentColor;

      margin: 0 auto;

      transition:
        transform 160ms ease,
        opacity 160ms ease;
    }

    .mobile-toggle span {
      position: relative;
    }

    .mobile-toggle span::before,
    .mobile-toggle span::after {
      content: "";

      position: absolute;
      left: 0;
    }

    .mobile-toggle span::before {
      top: -6px;
    }

    .mobile-toggle span::after {
      top: 6px;
    }

    .mobile-menu {
      display: none;

      padding: 10px 24px 20px;

      border-top: 1px solid var(--line-soft);
    }

    .mobile-menu.open {
      display: block;
    }

    .mobile-link {
      display: block;

      padding: 11px 0;

      color: var(--muted);

      font-size: 14px;

      border-bottom: 1px solid var(--line-soft);
    }

    .mobile-link:hover,
    .mobile-link.active {
      color: var(--ink);
    }

    .mobile-group {
      border-bottom: 1px solid var(--line-soft);
    }

    .mobile-group-button {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 12px 0;

      border: 0;
      background: transparent;

      color: var(--muted);

      font-size: 14px;
      text-align: left;

      cursor: pointer;
    }

    .mobile-group.open .mobile-group-button {
      color: var(--ink);
    }

    .mobile-submenu {
      display: none;

      padding: 0 0 8px 13px;
    }

    .mobile-group.open .mobile-submenu {
      display: block;
    }

    .mobile-sub-link {
      display: block;

      padding: 9px 0;

      color: var(--dim);

      font-size: 13px;
    }

    .mobile-sub-link:hover,
    .mobile-sub-link.active {
      color: var(--green2);
    }

    .mobile-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 8px;

      margin-top: 14px;
    }

    .mobile-action {
      padding: 11px;

      border: 1px solid var(--line);
      border-radius: 4px;

      text-align: center;
      font-size: 13px;
    }

    .mobile-action.primary {
      color: var(--bg);

      background: var(--green);
      border-color: var(--green);
    }

    /* =========================================================
       COMING SOON HERO
    ========================================================= */

    .coming-soon {
      position: relative;

      min-height: calc(100vh - 72px);

      display: flex;
      align-items: center;

      padding: 90px 0 110px;

      overflow: hidden;
    }

    .coming-soon::before {
      content: "";

      position: absolute;

      width: 620px;
      height: 620px;

      left: 50%;
      top: 50%;

      transform: translate(-50%, -50%);

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(62, 207, 142, 0.065),
          transparent 64%
        );

      pointer-events: none;
    }

    .coming-grid {
      position: relative;
      z-index: 2;

      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(360px, 0.8fr);

      align-items: center;

      gap: 90px;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;

      gap: 10px;

      margin-bottom: 24px;

      color: var(--green);

      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero-eyebrow::before {
      content: "";

      width: 24px;
      height: 1px;

      background: var(--green);
    }

    .hero-eyebrow::after {
      content: "COMING SOON";

      padding: 4px 7px;

      border: 1px solid rgba(62, 207, 142, 0.28);
      border-radius: 3px;

      color: var(--green2);

      background: rgba(62, 207, 142, 0.045);

      font-size: 9px;
      letter-spacing: 0.08em;
    }

    h1 {
      max-width: 720px;

      margin: 0;

      font-size: clamp(47px, 7vw, 82px);

      line-height: 0.96;

      letter-spacing: -0.06em;

      font-weight: 300;
    }

    h1 .green {
      color: var(--green);
    }

    .hero-description {
      max-width: 625px;

      margin: 28px 0 0;

      color: var(--muted);

      font-size: 17px;

      line-height: 1.75;
    }

    .hero-description strong {
      color: var(--ink);
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;

      gap: 10px;

      margin-top: 34px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 44px;

      padding: 0 17px;

      border: 1px solid var(--line);
      border-radius: 4px;

      font-size: 13px;
      font-weight: 400;

      transition:
        border-color 160ms ease,
        background 160ms ease,
        color 160ms ease;
    }

    .button.primary {
      color: var(--bg);

      background: var(--green);
      border-color: var(--green);
    }

    .button.primary:hover {
      background: var(--green2);
      border-color: var(--green2);
    }

    .button.secondary:hover {
      border-color: rgba(62, 207, 142, 0.42);
      background: rgba(62, 207, 142, 0.05);
    }

    /* =========================================================
       HUB STATUS VISUAL
    ========================================================= */

    .status-visual {
      position: relative;

      min-height: 420px;

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .status-orbit {
      position: absolute;

      border-radius: 50%;

      border: 1px solid var(--line-soft);
    }

    .status-orbit.one {
      width: 290px;
      height: 290px;
    }

    .status-orbit.two {
      width: 400px;
      height: 400px;

      border-color: rgba(62, 207, 142, 0.11);
    }

    .status-core {
      position: relative;

      width: 168px;
      height: 168px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      border: 1px solid rgba(62, 207, 142, 0.35);

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(62, 207, 142, 0.12),
          rgba(62, 207, 142, 0.025) 58%,
          transparent 74%
        );

      box-shadow:
        0 0 75px rgba(62, 207, 142, 0.075),
        inset 0 0 35px rgba(62, 207, 142, 0.035);
    }

    .status-core::before {
      content: "";

      position: absolute;

      width: 110px;
      height: 110px;

      border: 1px dashed rgba(62, 207, 142, 0.32);

      border-radius: 50%;

      animation: slowRotate 18s linear infinite;
    }

    @keyframes slowRotate {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .status-core-label {
      position: relative;
      z-index: 2;

      color: var(--ink);

      font-family: var(--mono);

      font-size: 13px;

      letter-spacing: 0.05em;
    }

    .status-core-state {
      position: relative;
      z-index: 2;

      margin-top: 7px;

      color: var(--green);

      font-family: var(--mono);

      font-size: 9px;

      letter-spacing: 0.09em;

      text-transform: uppercase;
    }

    .status-node {
      position: absolute;

      min-width: 126px;

      padding: 10px 12px;

      border: 1px solid var(--line);

      border-radius: 4px;

      background: rgba(23, 27, 24, 0.94);

      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);

      text-align: center;
    }

    .status-node-title {
      display: block;

      color: var(--ink);

      font-size: 12px;

      font-weight: 400;
    }

    .status-node-meta {
      display: block;

      margin-top: 2px;

      color: var(--dim);

      font-family: var(--mono);

      font-size: 9px;
    }

    .node-top {
      top: 22px;
      left: 50%;

      transform: translateX(-50%);
    }

    .node-right {
      right: 0;
      top: 50%;

      transform: translateY(-50%);
    }

    .node-bottom {
      bottom: 20px;
      left: 50%;

      transform: translateX(-50%);
    }

    .node-left {
      left: 0;
      top: 50%;

      transform: translateY(-50%);
    }

    /* =========================================================
       COMING SOON PANEL
    ========================================================= */

    .details {
      padding: 88px 0;

      border-top: 1px solid var(--line-soft);
    }

    .details-head {
      max-width: 670px;

      margin-bottom: 40px;
    }

    .section-label {
      margin-bottom: 12px;

      color: var(--green);

      font-family: var(--mono);

      font-size: 10px;

      letter-spacing: 0.1em;

      text-transform: uppercase;
    }

    h2 {
      margin: 0;

      font-size: clamp(31px, 4vw, 49px);

      line-height: 1.05;

      letter-spacing: -0.045em;

      font-weight: 300;
    }

    h2 .green {
      color: var(--green);
    }

    .details-intro {
      margin: 18px 0 0;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.75;
    }

    .capabilities {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 12px;
    }

    .capability {
      min-height: 190px;

      padding: 23px;

      border: 1px solid var(--line);

      border-radius: 5px;

      background: rgba(23, 27, 24, 0.72);
    }

    .capability-number {
      color: var(--green);

      font-family: var(--mono);

      font-size: 10px;
    }

    .capability h3 {
      margin: 28px 0 9px;

      color: var(--ink);

      font-size: 17px;

      font-weight: 400;

      letter-spacing: -0.02em;
    }

    .capability p {
      margin: 0;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.7;
    }

    /* =========================================================
       ECOSYSTEM STRIP
    ========================================================= */

    .ecosystem-section {
      padding: 88px 0;

      border-top: 1px solid var(--line-soft);
    }

    .ecosystem-panel {
      display: grid;

      grid-template-columns: 0.85fr 1.15fr;

      border: 1px solid var(--line);

      border-radius: 5px;

      overflow: hidden;

      background: rgba(23, 27, 24, 0.7);
    }

    .ecosystem-copy {
      padding: 42px;

      border-right: 1px solid var(--line);

      background:
        radial-gradient(
          circle at 0% 0%,
          rgba(62, 207, 142, 0.07),
          transparent 48%
        );
    }

    .ecosystem-copy h2 {
      font-size: 31px;
    }

    .ecosystem-copy p {
      max-width: 400px;

      margin: 18px 0 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.75;
    }

    .ecosystem-list {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 0;
    }

    .ecosystem-item {
      padding: 25px;

      border-bottom: 1px solid var(--line-soft);
    }

    .ecosystem-item:nth-child(odd) {
      border-right: 1px solid var(--line-soft);
    }

    .ecosystem-item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .ecosystem-item span {
      display: block;

      color: var(--green);

      font-family: var(--mono);

      font-size: 9px;

      letter-spacing: 0.07em;

      text-transform: uppercase;
    }

    .ecosystem-item h3 {
      margin: 9px 0 6px;

      color: var(--ink);

      font-size: 14px;

      font-weight: 400;
    }

    .ecosystem-item p {
      margin: 0;

      color: var(--dim);

      font-size: 11px;

      line-height: 1.6;
    }

    /* =========================================================
       FINAL CTA
    ========================================================= */

    .final-cta {
      padding: 100px 0 110px;

      text-align: center;

      border-top: 1px solid var(--line-soft);
    }

    .final-cta-inner {
      max-width: 720px;

      margin: 0 auto;
    }

    .final-cta h2 {
      font-size: clamp(36px, 5vw, 58px);
    }

    .final-cta p {
      max-width: 580px;

      margin: 20px auto 0;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.75;
    }

    .final-cta .hero-actions {
      justify-content: center;
    }

    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 55px 0 26px;

      border-top: 1px solid var(--line);
    }

    .footer-top {
      display: grid;

      grid-template-columns:
        1.5fr
        repeat(4, 1fr);

      gap: 40px;
    }

    .footer-brand {
      color: var(--ink);

      font-family: var(--mono);

      font-size: 15px;
    }

    .footer-brand-description {
      max-width: 220px;

      margin-top: 11px;

      color: var(--dim);

      font-size: 12px;

      line-height: 1.6;
    }

    .footer-heading {
      margin-bottom: 14px;

      color: var(--dim);

      font-family: var(--mono);

      font-size: 9px;

      letter-spacing: 0.1em;
    }

    .footer-links {
      display: grid;

      gap: 8px;
    }

    .footer-links a {
      color: var(--muted);

      font-size: 12px;

      transition: color 150ms ease;
    }

    .footer-links a:hover {
      color: var(--green);
    }

    .footer-bottom {
      display: flex;

      align-items: center;
      justify-content: space-between;

      margin-top: 55px;
      padding-top: 19px;

      border-top: 1px solid var(--line-soft);

      color: var(--dim);

      font-family: var(--mono);

      font-size: 9px;

      letter-spacing: 0.05em;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 1050px) {
      .desktop-nav {
        display: none;
      }

      .mobile-toggle {
        display: block;
      }

      .coming-grid {
        grid-template-columns: 1fr;

        gap: 45px;
      }

      .status-visual {
        min-height: 340px;
      }

      .footer-top {
        grid-template-columns:
          1.4fr
          1fr
          1fr;
      }
    }

    @media (max-width: 800px) {
      .container,
      .header-inner {
        width: min(var(--max), calc(100% - 32px));
      }

      .coming-soon {
        min-height: auto;

        padding: 78px 0 75px;
      }

      .details,
      .ecosystem-section {
        padding: 68px 0;
      }

      .capabilities {
        grid-template-columns: 1fr;
      }

      .ecosystem-panel {
        grid-template-columns: 1fr;
      }

      .ecosystem-copy {
        border-right: 0;

        border-bottom: 1px solid var(--line);
      }

      .footer-top {
        grid-template-columns: 1fr 1fr;

        gap: 35px 24px;
      }

      .footer-brand {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 560px) {
      .container,
      .header-inner {
        width: min(var(--max), calc(100% - 28px));
      }

      .mobile-menu {
        padding-left: 14px;
        padding-right: 14px;
      }

      h1 {
        font-size: clamp(42px, 13vw, 59px);
      }

      .hero-description {
        font-size: 15px;
      }

      .hero-actions {
        display: grid;

